# Razorpay Credentials (from your Razorpay Test Dashboard)
RAZORPAY_KEY_ID="rzp_test_yourkeyhere"
RAZORPAY_KEY_SECRET="your_razorpay_secret_here"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret_here"

# Gemini AI (Gemini 2.5 Flash)
GEMINI_API_KEY="AIzaSyYourGeminiKeyHere"

# Database (PostgreSQL)
# For local dev: postgresql://postgres:postgres@localhost:5432/revenue_recovery
# For production: Update with your managed DB connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/revenue_recovery"

# Security (Bearer Auth)
# Note: If ADMIN_API_SECRET is left blank, auth will be disabled (for local dev only).
ADMIN_API_SECRET="your_secure_random_string_here"
VITE_ADMIN_API_SECRET="your_secure_random_string_here" # Same as above, for the frontend
# Frontend / API Server
PORT=4000
# Update this for production to your Vercel URL
CORS_ORIGIN="http://localhost:5173"
